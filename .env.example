# SPECTRE Training Pipeline Configuration
# Copy this file to .env and fill in your values

# OpenRouter API Key (required)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-key-here

# Model selection (OpenRouter format: provider/model)
TEACHER_MODEL=anthropic/claude-3.5-sonnet
JUDGE_A_MODEL=anthropic/claude-3.5-haiku
JUDGE_B_MODEL=openai/gpt-4o-mini

# Pipeline settings
TARGET_EXAMPLES=1000
MAP_NAME=stratis
