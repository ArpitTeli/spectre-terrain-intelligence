{
  "name": "spectre-pipeline",
  "version": "1.1.0",
  "description": "SPECTRE Training Data Pipeline - Generate synthetic training data for tactical AI",
  "main": "electron/main.js",
  "scripts": {
    "start": "concurrently \"react-scripts start\" \"wait-on http://localhost:3000 && electron .\"",
    "react": "react-scripts start",
    "electron": "electron .",
    "build-react": "react-scripts build",
    "build": "npm run build-react && electron-builder",
    "build-win": "npm run build-react && electron-builder --win"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "react-scripts": "^5.0.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.spectre.pipeline",
    "productName": "SPECTRE Pipeline",
    "extends": null,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "build",
        "to": "build"
      },
      {
        "from": "backend",
        "to": "backend"
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
